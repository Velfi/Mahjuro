{
  "_comment": "assign_pack precedence: see bake_assets.py. music (lazy) is listed before shared so audio/music/ files route there even though they share the audio/ prefix. shared (eager) = cross-scene: fonts, sets/, all other audio/ SFX. gameplay (eager) = bulk 3D/UI. scene_main_menu (lazy) = main menu façade + future scene-only assets under scenes/main_menu/.",
  "packs": [
    {
      "id": "music",
      "file": "mahjuro-pack-music.zip",
      "load_tier": "lazy",
      "path_prefixes": ["audio/music/"]
    },
    {
      "id": "shared",
      "file": "mahjuro-pack-shared.zip",
      "load_tier": "eager",
      "path_prefixes": [
        "sets/",
        "audio/",
        "Instrument_Serif/",
        "Cormorant_Garamond/",
        "Noto_Emoji/"
      ],
      "root_files": []
    },
    {
      "id": "gameplay",
      "file": "mahjuro-pack-gameplay.zip",
      "load_tier": "eager",
      "path_prefixes": [
        "data/",
        "textures/",
        "kenney_input-prompts/",
        "steam_assets/"
      ],
      "root_globs": ["*.glb", "*.png"]
    },
    {
      "id": "scene_main_menu",
      "file": "mahjuro-pack-scene-main_menu.zip",
      "load_tier": "lazy",
      "path_prefixes": ["scenes/main_menu/"]
    }
  ]
}
