# Mahjuro Steam upload targets (sourced by scripts/steam-upload.sh).
# Override any value via the environment when invoking the script.

# Main game (release + internal/beta branches on this AppID)
STEAM_APP_ID=4636490
STEAM_DEPOT_WINDOWS=4636491
STEAM_DEPOT_MACOS=4636492

# Steam Playtest child app — per-OS depots (same layout as the main game).
# Partner: Mahjuro → Associated Packages & DLC → Playtest → SteamPipe → Depots.
STEAM_PLAYTEST_APP_ID=4819450
STEAM_PLAYTEST_DEPOT_WINDOWS=4819451
STEAM_PLAYTEST_DEPOT_MACOS=4819452
# Branch promoted on the playtest app when using --beta (defaults to default).
# STEAM_PLAYTEST_BRANCH=default
